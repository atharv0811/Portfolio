# Public URL of the deployed site (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form delivery (server-only — never prefix with NEXT_PUBLIC_).
# Leave RESEND_API_KEY empty to run the form in preview mode (development only).
RESEND_API_KEY=
# Inbox that receives project inquiries.
CONTACT_TO_EMAIL=you@example.com
# Verified sender on your Resend domain, e.g. "Portfolio <hello@your-domain.com>".
CONTACT_FROM_EMAIL=
